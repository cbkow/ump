+/* Adaptive Colour Transform fix-up for one macroblock row of a 4:4:4
+ * frame that mixes RGB and YCbCr macroblocks (Avid DNxHR 444 with the
+ * header ACT flag). The IDCT pass left every macroblock in the colour
+ * space it was coded in, with components in bitstream order:
+ *   act = 0  →  (R, G, B)
+ *   act = 1  →  (Y, Cb, Cr), full-range BT.709, chroma offset 2^(depth-1)
+ * (both established empirically against Avid-encoded material: the RGB
+ * macroblocks' component order and the YCbCr matrix/range were fitted
+ * across thousands of RGB/YCbCr macroblock boundaries — BT.709 full
+ * range matches to the quantisation noise floor, limited range / BT.601
+ * / YCoCg do not). Bring every macroblock to GBRP plane order
+ * (G, B, R) so the frame is one consistent RGB picture. */
+static int dnxhd_act_row(AVCodecContext *avctx, void *data,
+                         int rownb, int threadnb)
+{
+    const DNXHDContext *ctx = avctx->priv_data;
+    AVFrame *frame = data;
+    const int maxv = (1 << ctx->bit_depth) - 1;
+    const int off  = 1 << (ctx->bit_depth - 1);
+    const int mb_h = FFMIN(16, (int)ctx->height - rownb * 16);
+    int x, i, j;
+
+    if (mb_h <= 0)
+        return 0;
+
+    for (x = 0; x < ctx->mb_width; x++) {
+        const int act = ctx->act_map[rownb * ctx->mb_width + x];
+        const int mb_w = FFMIN(16, (int)ctx->width - x * 16);
+        for (i = 0; i < mb_h; i++) {
+            uint16_t *p0 = (uint16_t *)(frame->data[0] + (rownb * 16 + i) * frame->linesize[0]) + x * 16;
+            uint16_t *p1 = (uint16_t *)(frame->data[1] + (rownb * 16 + i) * frame->linesize[1]) + x * 16;
+            uint16_t *p2 = (uint16_t *)(frame->data[2] + (rownb * 16 + i) * frame->linesize[2]) + x * 16;
+            if (act) {
+                for (j = 0; j < mb_w; j++) {
+                    const int Y  = p0[j];
+                    const int cb = p1[j] - off;
+                    const int cr = p2[j] - off;
+                    /* BT.709 full range, 16.16 fixed point:
+                     * R = Y + 1.5748 Cr; G = Y - 0.18732 Cb - 0.46812 Cr;
+                     * B = Y + 1.8556 Cb */
+                    const int r = Y + ((103206 * cr + 32768) >> 16);
+                    const int g = Y - ((12276 * cb + 30679 * cr + 32768) >> 16);
+                    const int b = Y + ((121608 * cb + 32768) >> 16);
+                    p0[j] = av_clip(g, 0, maxv);
+                    p1[j] = av_clip(b, 0, maxv);
+                    p2[j] = av_clip(r, 0, maxv);
+                }
+            } else {
+                for (j = 0; j < mb_w; j++) {
+                    const uint16_t r = p0[j], g = p1[j], b = p2[j];
+                    p0[j] = g;
+                    p1[j] = b;
+                    p2[j] = r;
+                }
+            }
+        }
+    }
+    return 0;
+}
