<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity
    Name="cbkow.QCView"
    Version="1.1.5.0"
    Publisher="CN=C64A1D41-EFAA-4EED-AE81-0C074867D4E9"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>QCView</DisplayName>
    <PublisherDisplayName>cbkow</PublisherDisplayName>
    <Logo>images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="QCView" Executable="qcview.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="QCView"
        Description="Professional media player and reviewer"
        BackgroundColor="transparent"
        Square150x150Logo="images\Square150x150Logo.png"
        Square44x44Logo="images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="images\Wide310x150Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Project file associations -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="qcviewproject">
            <uap:DisplayName>QCView Project</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.qcv</uap:FileType>
              <uap:FileType>.qcvproj</uap:FileType>
              <uap:FileType>.qcvexr</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- Video file associations -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="qcviewvideo">
            <uap:DisplayName>Video File</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.mp4</uap:FileType>
              <uap:FileType>.mkv</uap:FileType>
              <uap:FileType>.avi</uap:FileType>
              <uap:FileType>.mov</uap:FileType>
              <uap:FileType>.wmv</uap:FileType>
              <uap:FileType>.flv</uap:FileType>
              <uap:FileType>.webm</uap:FileType>
              <uap:FileType>.m4v</uap:FileType>
              <uap:FileType>.m2ts</uap:FileType>
              <uap:FileType>.mts</uap:FileType>
              <uap:FileType>.ts</uap:FileType>
              <uap:FileType>.mxf</uap:FileType>
              <uap:FileType>.ogv</uap:FileType>
              <uap:FileType>.3gp</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- Image file associations -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="qcviewimage">
            <uap:DisplayName>Image File</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.exr</uap:FileType>
              <uap:FileType>.gif</uap:FileType>
              <uap:FileType>.hdr</uap:FileType>
              <uap:FileType>.tif</uap:FileType>
              <uap:FileType>.tiff</uap:FileType>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.jpg</uap:FileType>
              <uap:FileType>.jpeg</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- Audio file associations -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="qcviewaudio">
            <uap:DisplayName>Audio File</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.wav</uap:FileType>
              <uap:FileType>.mp3</uap:FileType>
              <uap:FileType>.aac</uap:FileType>
              <uap:FileType>.flac</uap:FileType>
              <uap:FileType>.ogg</uap:FileType>
              <uap:FileType>.m4a</uap:FileType>
              <uap:FileType>.wma</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- Protocol handler: qcview:// -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="qcview">
            <uap:DisplayName>QCView Protocol</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>

        <!-- Execution alias: run "qcview" from any terminal -->
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="qcview.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>


</Package>
