<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <!-- Bundle identifier intentionally distinct from the old app
         (app.qcview.QCView) so the two installs coexist on the same
         machine. The old /Applications/qcview.app stays the
         production reference; this port runs alongside. -->
    <key>CFBundleIdentifier</key>
    <string>app.qcview.player</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>QCView</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <key>CFBundleIconFile</key>
    <string>qcview.icns</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.video</string>

    <!-- ================================================================ -->
    <!-- Sparkle auto-update (macOS). Appcast on the qcview.app Pages site;  -->
    <!-- daily background checks; no anonymized system profiling.           -->
    <!-- SUPublicEDKey MUST be replaced with the real Ed25519 public key     -->
    <!-- printed by external/Sparkle/bin/generate_keys (private key lives    -->
    <!-- in the login Keychain + a base64 backup in the maintainer's vault). -->
    <!-- ================================================================ -->
    <key>SUFeedURL</key>
    <string>https://qcview.app/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>+Xlrad3WswxIRTyzBTp8KaTEjyfPO5Ap4llmPdZf3RQ=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
    <key>SUEnableSystemProfiling</key>
    <false/>

    <!-- ================================================================ -->
    <!-- Document Types                                                    -->
    <!-- ================================================================ -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <!-- QCView Project (owned by this app) -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>QCView Project</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>app.qcview.qcv</string>
                <string>app.qcview.qcvproj</string>
            </array>
        </dict>

        <!-- Video Files (viewer — don't claim default) -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>Video File</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.apple.quicktime-movie</string>
                <string>public.mpeg-4</string>
                <string>public.avi</string>
                <string>com.apple.m4v-video</string>
                <string>org.webmproject.webm</string>
                <string>org.smpte.mxf</string>
            </array>
            <!-- Fallback for types without system UTIs -->
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>mkv</string>
            </array>
        </dict>

        <!-- Image Files. public.jpeg covers .jpg + .jpeg;
             public.tiff covers .tif + .tiff. DPX has no standard
             system UTI so it falls into CFBundleTypeExtensions. -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>Image File</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.ilm.openexr-image</string>
                <string>public.tiff</string>
                <string>public.png</string>
                <string>public.jpeg</string>
                <string>com.compuserve.gif</string>
                <string>com.microsoft.bmp</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>dpx</string>
            </array>
        </dict>

        <!-- Audio File doc type intentionally left out for v2.0.
             The decode + load path lumps audio into VideoDecoder
             and likely fails on pure-audio files (no video stream
             → open returns false → AudioPlayer chain never primes).
             Re-add once we have an audio-only load + render path,
             plus waveform / inspector treatment. -->
    </array>

    <!-- ================================================================ -->
    <!-- Custom URI Scheme (qcview:// deep links)                          -->
    <!-- Matches Windows registry + Linux .desktop X-Scheme-Handler        -->
    <!-- Inbound handling: WindowManager::openProjectLink                  -->
    <!-- ================================================================ -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>QCView Project URI</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>qcview</string>
            </array>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
        </dict>
    </array>

    <!-- ================================================================ -->
    <!-- Exported Type Declarations (types owned by QCView)                -->
    <!-- ================================================================ -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <!-- .qcv -->
        <dict>
            <key>UTTypeIdentifier</key>
            <string>app.qcview.qcv</string>
            <key>UTTypeDescription</key>
            <string>QCView Project</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>qcv</string>
                </array>
            </dict>
        </dict>

        <!-- .qcvproj -->
        <dict>
            <key>UTTypeIdentifier</key>
            <string>app.qcview.qcvproj</string>
            <key>UTTypeDescription</key>
            <string>QCView Project</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>qcvproj</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
